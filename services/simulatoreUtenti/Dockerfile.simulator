FROM python:3.11-slim

WORKDIR /app

# Copia lo script e le dipendenze dal contesto services
COPY heartRateSimulation.py .
COPY requirements-simulator.txt .

# Installa dipendenze Python
RUN pip install --no-cache-dir -r requirements-simulator.txt

# Parametri modificabili durante la build con --build-arg
ARG ENDPOINT_URL=http://backend:3001/api/v1/pushToKafka
ARG NUM_ATHLETES=20000
ARG SAMPLE_INTERVAL=5.0
ARG DANGER_EVENT_PROBABILITY=0.05
ARG DANGER_MIN_SAMPLES=6
ARG DANGER_MAX_SAMPLES=18
ARG MIN_SESSION_MINUTES=2
ARG MAX_SESSION_MINUTES=5
ARG MIN_REST_MINUTES=5
ARG MAX_REST_MINUTES=6
ARG INITIAL_START_WINDOW_MINUTES=1

ENV ENDPOINT_URL=${ENDPOINT_URL}
ENV NUM_ATHLETES=${NUM_ATHLETES}
ENV SAMPLE_INTERVAL=${SAMPLE_INTERVAL}
ENV DANGER_EVENT_PROBABILITY=${DANGER_EVENT_PROBABILITY}
ENV DANGER_MIN_SAMPLES=${DANGER_MIN_SAMPLES}
ENV DANGER_MAX_SAMPLES=${DANGER_MAX_SAMPLES}
ENV MIN_SESSION_MINUTES=${MIN_SESSION_MINUTES}
ENV MAX_SESSION_MINUTES=${MAX_SESSION_MINUTES}
ENV MIN_REST_MINUTES=${MIN_REST_MINUTES}
ENV MAX_REST_MINUTES=${MAX_REST_MINUTES}
ENV INITIAL_START_WINDOW_MINUTES=${INITIAL_START_WINDOW_MINUTES}

# Entrypoint
CMD ["python", "heartRateSimulation.py"]
