PORT=3001
CORS_ORIGIN=http://localhost:5173

# PostgreSQL database connection
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bigintensive
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
CITUS_HOST=citus-coordinator
CITUS_PORT=5432

# Optional: absolute path to Python executable when python/py is not in PATH
# Example: C:/Users/<you>/AppData/Local/Programs/Python/Python311/python.exe
PYTHON_BIN=

# Kafka settings for backend publishing (simulation micro-batches)
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_CLIENT_ID=bigintensive-backend
SMARTWATCH_KAFKA_TOPIC=heart-rate-events

# Spark streaming defaults used by backend /spark/streaming/* endpoints
SPARK_COMPOSE_SERVICE=spark-master
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_APPS_DIR=/opt/spark-apps
SPARK_KAFKA_BOOTSTRAP_SERVERS=kafka:19092
SPARK_KAFKA_TOPIC=heart-rate-events
SPARK_CLICKHOUSE_JDBC_URL=jdbc:clickhouse://clickhouse:8123/bigintensive
SPARK_CLICKHOUSE_TABLE=bigintensive.corsa_endurance_campioni
SPARK_CLICKHOUSE_USER=default
SPARK_CLICKHOUSE_PASSWORD=
SPARK_CHECKPOINT_DIR=/tmp/spark-checkpoints/smartwatch-to-clickhouse

# Optional table for normal workout inserts when destination=clickhouse
CLICKHOUSE_WORKOUTS_TABLE=workout_plans
